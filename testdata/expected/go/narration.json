      "byte_start": 710,
      "byte_end": 779,
      "semantics": [
        "language:go",
        "control-flow"
      ]
    },
    {
      "seq": 25,
      "kind": "paragraph",
      "text": "It assigns all bytes read from source to data and err.",
      "level": 0,
