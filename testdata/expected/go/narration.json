    },
    {
      "seq": 23,
      "kind": "paragraph",
      "text": "Function load accepts ctx as a context type from context and source as a reader type from io. It returns a slice of entry and an error.",
      "level": 0,
      "byte_start": 641,
      "byte_end": 706,
      "semantics": [
        "language:go",
        "function-signature"
      ]
    },
    {
      "seq": 24,
      "kind": "paragraph",
      "text": "If the error reported by ctx does not equal nil, it returns nil and a new error containing the text request canceled.",
